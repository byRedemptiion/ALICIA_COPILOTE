# Facultatif : les valeurs par défaut fonctionnent sans clé ni compte payant.
ALICIA_AI_PROVIDER=ollama
ALICIA_OLLAMA_MODEL=qwen2.5vl:7b
ALICIA_OLLAMA_URL=http://127.0.0.1:11434
ALICIA_API_TIMEOUT_SECONDS=120
ALICIA_IMAGE_MAX_EDGE=1600
ALICIA_CAPTURE_INTERVAL_MS=1000

# Facultatif : chemin du modèle Vosk local préparé par Installer_Alicia.bat.
# ALICIA_VOICE_MODEL_PATH=C:\chemin\vosk-model-small-fr-0.22

# Voix locale Windows, française et féminine. Vide = sélection automatique.
ALICIA_TTS_PROVIDER=windows
ALICIA_WINDOWS_VOICE=
ALICIA_WINDOWS_RATE=-1

# Ancien fournisseur externe facultatif : activé uniquement par choix explicite.
# ALICIA_AI_PROVIDER=openai
# ALICIA_AI_MODEL=gpt-4.1-mini
# ALICIA_TTS_PROVIDER=openai
# ALICIA_TTS_MODEL=gpt-4o-mini-tts
# ALICIA_TTS_VOICE=shimmer
# OPENAI_API_KEY=
