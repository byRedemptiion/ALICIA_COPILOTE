# Facultatif : les valeurs par défaut fonctionnent sans clé ni compte payant.
ALICIA_AI_PROVIDER=ollama
ALICIA_OLLAMA_MODEL=qwen3-vl:8b
ALICIA_OLLAMA_URL=http://127.0.0.1:11434
ALICIA_API_TIMEOUT_SECONDS=120
ALICIA_IMAGE_MAX_EDGE=1600
ALICIA_CAPTURE_INTERVAL_MS=1000

# Notes et comptes rendus créés uniquement sur demande explicite.
# ALICIA_NOTES_DIR=C:\chemin\Alicia\notes

# Voix expressive française féminine, calculée sur le PC dans un moteur isolé.
ALICIA_TTS_PROVIDER=chatterbox
ALICIA_EXPRESSIVE_DEVICE=auto
# ALICIA_EXPRESSIVE_MODEL_DIR=C:\chemin\chatterbox-models
# ALICIA_EXPRESSIVE_RUNTIME_DIR=C:\chemin\chatterbox-runtime

# Autre voix locale plus légère : choisir explicitement ALICIA_TTS_PROVIDER=kokoro.
ALICIA_NEURAL_VOICE=ff_siwis
ALICIA_NEURAL_SPEED=0.95
# ALICIA_NEURAL_MODEL_DIR=C:\chemin\kokoro

# Reconnaissance multilingue large-v3-turbo. CUDA si fonctionnel, sinon CPU.
ALICIA_STT_PROVIDER=whisper
ALICIA_WHISPER_DEVICE=auto
# ALICIA_WHISPER_MODEL_PATH=C:\chemin\faster-whisper-large-v3-turbo
