# Facultatif : les valeurs par défaut fonctionnent sans clé ni compte payant.
ALICIA_AI_PROVIDER=ollama
ALICIA_OLLAMA_MODEL=qwen2.5vl:7b
ALICIA_OLLAMA_URL=http://127.0.0.1:11434
ALICIA_API_TIMEOUT_SECONDS=120
ALICIA_IMAGE_MAX_EDGE=1600
ALICIA_CAPTURE_INTERVAL_MS=1000

# Voix neuronale française féminine, calculée sur le PC.
ALICIA_TTS_PROVIDER=kokoro
ALICIA_NEURAL_VOICE=ff_siwis
ALICIA_NEURAL_SPEED=0.95
# ALICIA_NEURAL_MODEL_DIR=C:\chemin\kokoro

# Reconnaissance française locale plus précise. CPU par défaut sans configuration CUDA.
ALICIA_STT_PROVIDER=whisper
ALICIA_WHISPER_DEVICE=cpu
# ALICIA_WHISPER_MODEL_PATH=C:\chemin\faster-whisper-small
